import com.sun.jna.Structure;
import com.sun.jna.Structure.FieldOrder;
import java.nio.charset.StandardCharsets;

@FieldOrder({"type", "subtype"})
public class TransactionType extends Structure {
    public byte[] type = new byte[2];
    public byte[] subtype = new byte[2];

    public TransactionType() { super(ALIGN_NONE); }

    /** Convenient setter for the 2-char codes */
    public void setCodes(String t, String st) {
        System.arraycopy(t.getBytes(StandardCharsets.US_ASCII), 0, type, 0, 2);
        System.arraycopy(st.getBytes(StandardCharsets.US_ASCII), 0, subtype, 0, 2);
    }

    public static class ByReference extends TransactionType implements Structure.ByReference {}
}

